# GEMINI_API_KEY: Unused unless Gemini REST API is needed.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional Backend Payment Verification & Public Checkout Configuration
# Never store Paystack/Flutterwave secret keys in the Android app.
# Configure your backend verification endpoint URL (which holds the gateway secret server-side):
PAYMENT_CHECKOUT_PUBLIC_KEY=MY_PAYMENT_CHECKOUT_PUBLIC_KEY
PAYMENT_VERIFY_ENDPOINT_URL=MY_PAYMENT_VERIFY_ENDPOINT_URL

# Single-Administrator Authentication Server URL
# Deploy admin-auth-server and configure ADMIN_AUTH_ENDPOINT_URL in AI Studio Secrets.
# Never store admin passwords, scrypt hashes, or signing secrets in the Android app.
ADMIN_AUTH_ENDPOINT_URL=MY_ADMIN_AUTH_ENDPOINT_URL
